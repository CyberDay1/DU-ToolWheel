<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Embedded DLL mod for a myDU server. The output DLL name must start with "Mod".
    NQ assemblies are referenced from $(NQLibDir); copy them from the mod toolkit's
    ModAdmin folder (see README). They are never copied to the output: the Orleans
    host already loads them.
  -->
  <PropertyGroup>
    <Nullable>annotations</Nullable>
    <AssemblyName>ModToolWheel</AssemblyName>
    <RootNamespace>ToolWheel</RootNamespace>
    <NQLibDir Condition="'$(NQLibDir)' == ''">$(MSBuildThisFileDirectory)lib\</NQLibDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <!-- The client script ships inside the DLL; a toolwheel.js next to the DLL overrides it. -->
    <EmbeddedResource Include="src\client\toolwheel.js" LogicalName="ToolWheel.toolwheel.js" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="NQutils"><HintPath>$(NQLibDir)NQutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Backend"><HintPath>$(NQLibDir)Backend.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Backend.PubSub"><HintPath>$(NQLibDir)Backend.PubSub.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Interfaces"><HintPath>$(NQLibDir)Interfaces.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Router.Orleans"><HintPath>$(NQLibDir)Router.Orleans.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Core" Version="3.6.5" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Orleans.Core.Abstractions" Version="3.6.5" ExcludeAssets="runtime" />
    <PackageReference Include="Google.Protobuf" Version="3.21.9" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- https://github.com/dotnet/efcore/issues/15047 (same workaround as the toolkit samples) -->
  <Target Name="AddAssemblyAliasToReactiveAsync" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Condition=" '%(FileName)' == 'System.Interactive.Async' ">
        <Aliases>reactive</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>
</Project>
